<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:UHabitacional.MOBILE.Models"
             x:Class="UHabitacional.MOBILE.Pages.DepartamentosPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource Background}">

    <Grid RowDefinitions="Auto,*">

        <!-- HEADER -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Padding="16,14">
            <Label Grid.Column="0" Text="←" FontSize="22" TextColor="{StaticResource Ink}"
                   VerticalOptions="Center">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnRegresarTapped" />
                </Label.GestureRecognizers>
            </Label>
            <Label Grid.Column="1" Text="Departamentos" FontSize="16" FontAttributes="Bold"
                   TextColor="{StaticResource Ink}"
                   HorizontalOptions="Center" VerticalOptions="Center" />
        </Grid>

        <!-- BODY -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,4,16,16" Spacing="11">

                <Label Text="Unidades del conjunto habitacional"
                       FontSize="12" TextColor="{StaticResource Muted}"
                       Margin="2,4,0,4" />

                <!-- Filtro por edificio -->
                <Border BackgroundColor="{StaticResource Surface}" Stroke="{StaticResource Line}"
                        StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="12,2">
                    <Picker x:Name="EdificioPicker"
                            Title="Filtrar por edificio..."
                            ItemDisplayBinding="{Binding Nombre}"
                            SelectedIndexChanged="OnEdificioFiltroChanged" />
                </Border>

                <ActivityIndicator x:Name="LoadingIndicator"
                                   IsVisible="False" IsRunning="False"
                                   Color="{StaticResource Primary}"
                                   HorizontalOptions="Center"
                                   Margin="0,24,0,0" />

                <Label x:Name="MensajeLabel"
                       IsVisible="False"
                       FontSize="13"
                       TextColor="{StaticResource Muted}"
                       HorizontalTextAlignment="Center"
                       Margin="0,24,0,0" />

                <!-- Lista de departamentos -->
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding DepartamentosFiltrados}"
                                     Spacing="11">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:Departamento">
                            <Border Style="{StaticResource ModuloCard}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnDepartamentoTapped"
                                                          CommandParameter="{Binding IdDepartamento}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">

                                    <!-- Icono -->
                                    <Border Grid.Column="0"
                                            BackgroundColor="{StaticResource Accent100}"
                                            Style="{StaticResource IconoBox}"
                                            VerticalOptions="Center">
                                        <Label Text="🏠" FontSize="18"
                                               HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>

                                    <!-- Datos -->
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="3">
                                        <Label Text="{Binding NumeroDepartamento}"
                                               Style="{StaticResource ModuloTitulo}" />
                                        <Label Text="{Binding NombreEdificio}"
                                               Style="{StaticResource ModuloDesc}" />
                                        <HorizontalStackLayout Spacing="6">
                                            <Border Style="{StaticResource Pill}">
                                                <Label Text="{Binding PisoTexto}"
                                                       FontSize="10" TextColor="{StaticResource Muted}" />
                                            </Border>
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>

                                    <Label Grid.Column="2" Text="›" FontSize="22"
                                           TextColor="{StaticResource Muted}" VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Botón FAB: nuevo departamento -->
        <Border Grid.Row="1"
                BackgroundColor="{StaticResource Primary}"
                WidthRequest="56" HeightRequest="56"
                StrokeThickness="0" StrokeShape="RoundRectangle 28"
                HorizontalOptions="End" VerticalOptions="End"
                Margin="0,0,20,20">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnNuevoDepartamentoTapped" />
            </Border.GestureRecognizers>
            <Label Text="+" FontSize="28" TextColor="White"
                   HorizontalOptions="Center" VerticalOptions="Center" />
        </Border>

    </Grid>
</ContentPage>
