<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="UHabitacional.MOBILE.Pages.RegistroVisitantePage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource Background}">

    <Grid RowDefinitions="Auto,*">

        <!-- HEADER -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Padding="16,14">
            <Label Grid.Column="0" Text="←" FontSize="22" TextColor="{StaticResource Ink}"
                   VerticalOptions="Center">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnRegresarTapped" />
                </Label.GestureRecognizers>
            </Label>
            <Label Grid.Column="1" Text="Registro de visitante" FontSize="16" FontAttributes="Bold"
                   TextColor="{StaticResource Ink}"
                   HorizontalOptions="Center" VerticalOptions="Center" />
        </Grid>

        <!-- BODY -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,4,16,24" Spacing="14">

                <Label Text="Solicita al visitante su código y valídalo para registrar su acceso."
                       FontSize="12" TextColor="{StaticResource Muted}"
                       Margin="2,4,0,4" />

                <!-- TARJETA: Ingreso de código -->
                <Border Style="{StaticResource ModuloCard}" Padding="18">
                    <VerticalStackLayout Spacing="14">

                        <Label Text="Código de visita" FontSize="12" FontAttributes="Bold"
                               TextColor="{StaticResource Ink}" />

                        <!-- Campo de código grande -->
                        <Border BackgroundColor="{StaticResource Surface}" Stroke="{StaticResource Line}"
                                StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="16,4">
                            <Entry x:Name="CodigoEntry"
                                   Placeholder="Ej. A1B2C3"
                                   FontSize="24" FontAttributes="Bold"
                                   CharacterSpacing="4"
                                   MaxLength="6"
                                   TextColor="{StaticResource Primary}"
                                   TextTransform="Uppercase"
                                   Keyboard="Text"
                                   ReturnCommand="{Binding ValidarCommand}"
                                   TextChanged="OnCodigoTextChanged" />
                        </Border>

                        <Label Text="6 caracteres alfanuméricos (mayúsculas o minúsculas)"
                               FontSize="11" TextColor="{StaticResource Muted}" />

                        <!-- Error de búsqueda -->
                        <Label x:Name="ErrorLabel"
                               IsVisible="False"
                               FontSize="13" TextColor="{StaticResource Danger}" />

                        <ActivityIndicator x:Name="LoadingIndicator"
                                           IsVisible="False" IsRunning="False"
                                           Color="{StaticResource Primary}"
                                           HorizontalOptions="Center" />

                        <Button x:Name="ValidarButton"
                                Text="Validar código"
                                Clicked="OnValidarClicked"
                                IsEnabled="False" />
                    </VerticalStackLayout>
                </Border>

                <!-- TARJETA: Resultado del visitante (oculta hasta validar) -->
                <Border x:Name="ResultadoCard"
                        IsVisible="False"
                        Style="{StaticResource ModuloCard}"
                        Padding="18">
                    <VerticalStackLayout Spacing="14">

                        <!-- Encabezado resultado -->
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="Visitante validado"
                                   FontSize="15" FontAttributes="Bold"
                                   TextColor="{StaticResource Primary}"
                                   VerticalOptions="Center" />
                            <Border Grid.Column="1"
                                    BackgroundColor="{StaticResource Primary50}"
                                    Stroke="{StaticResource Primary}"
                                    StrokeThickness="1" Padding="8,3"
                                    StrokeShape="RoundRectangle 999">
                                <Label Text="✓ Código válido" FontSize="11" FontAttributes="Bold"
                                       TextColor="{StaticResource Primary}" />
                            </Border>
                        </Grid>

                        <!-- Separador -->
                        <BoxView HeightRequest="1" BackgroundColor="{StaticResource Line}" />

                        <!-- Datos del visitante -->
                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                              ColumnSpacing="12" RowSpacing="10">

                            <Label Grid.Row="0" Grid.Column="0" Text="Visitante"
                                   FontSize="12" TextColor="{StaticResource Muted}"
                                   VerticalOptions="Center" />
                            <Label x:Name="NombreVisitanteLabel" Grid.Row="0" Grid.Column="1"
                                   FontSize="13" FontAttributes="Bold" TextColor="{StaticResource Ink}"
                                   VerticalOptions="Center" />

                            <Label Grid.Row="1" Grid.Column="0" Text="Identificación"
                                   FontSize="12" TextColor="{StaticResource Muted}"
                                   VerticalOptions="Center" />
                            <Label x:Name="IdentificacionLabel" Grid.Row="1" Grid.Column="1"
                                   FontSize="13" TextColor="{StaticResource Ink}"
                                   VerticalOptions="Center" />

                            <Label Grid.Row="2" Grid.Column="0" Text="Inquilino"
                                   FontSize="12" TextColor="{StaticResource Muted}"
                                   VerticalOptions="Center" />
                            <Label x:Name="InquilinoLabel" Grid.Row="2" Grid.Column="1"
                                   FontSize="13" TextColor="{StaticResource Ink}"
                                   VerticalOptions="Center" />

                            <Label Grid.Row="3" Grid.Column="0" Text="Motivo"
                                   FontSize="12" TextColor="{StaticResource Muted}"
                                   VerticalOptions="Center" />
                            <Label x:Name="ObservacionesLabel" Grid.Row="3" Grid.Column="1"
                                   FontSize="13" TextColor="{StaticResource Ink}"
                                   VerticalOptions="Center" />

                            <Label Grid.Row="4" Grid.Column="0" Text="Código"
                                   FontSize="12" TextColor="{StaticResource Muted}"
                                   VerticalOptions="Center" />
                            <Label x:Name="CodigoResultadoLabel" Grid.Row="4" Grid.Column="1"
                                   FontSize="16" FontAttributes="Bold" TextColor="{StaticResource Primary}"
                                   CharacterSpacing="3" VerticalOptions="Center" />

                            <!-- Hora entrada (condicional) -->
                            <Label x:Name="EntradaTituloLabel" Grid.Row="5" Grid.Column="0"
                                   IsVisible="False" Text="Entrada"
                                   FontSize="12" TextColor="{StaticResource Muted}"
                                   VerticalOptions="Center" />
                            <Label x:Name="EntradaLabel" Grid.Row="5" Grid.Column="1"
                                   IsVisible="False"
                                   FontSize="13" TextColor="{StaticResource Success}"
                                   FontAttributes="Bold" VerticalOptions="Center" />

                            <!-- Hora salida (condicional) -->
                            <Label x:Name="SalidaTituloLabel" Grid.Row="6" Grid.Column="0"
                                   IsVisible="False" Text="Salida"
                                   FontSize="12" TextColor="{StaticResource Muted}"
                                   VerticalOptions="Center" />
                            <Label x:Name="SalidaLabel" Grid.Row="6" Grid.Column="1"
                                   IsVisible="False"
                                   FontSize="13" TextColor="{StaticResource Accent}"
                                   FontAttributes="Bold" VerticalOptions="Center" />
                        </Grid>

                        <!-- Mensaje de acción (error o éxito) -->
                        <Label x:Name="AccionMensajeLabel"
                               IsVisible="False"
                               FontSize="13"
                               HorizontalTextAlignment="Center" />

                        <ActivityIndicator x:Name="AccionLoadingIndicator"
                                           IsVisible="False" IsRunning="False"
                                           Color="{StaticResource Primary}"
                                           HorizontalOptions="Center" />

                        <!-- Botones de acción adaptativos -->
                        <Button x:Name="EntradaButton"
                                IsVisible="False"
                                Text="✓  Registrar entrada"
                                Clicked="OnEntradaClicked" />

                        <Button x:Name="SalidaButton"
                                IsVisible="False"
                                Text="Registrar salida"
                                BackgroundColor="{StaticResource Accent}"
                                Clicked="OnSalidaClicked" />

                        <!-- Visita completada -->
                        <Border x:Name="CompletadaBadge"
                                IsVisible="False"
                                BackgroundColor="{StaticResource Primary50}"
                                Stroke="{StaticResource Primary}"
                                StrokeThickness="1" Padding="14,8"
                                StrokeShape="RoundRectangle 12"
                                HorizontalOptions="Center">
                            <Label Text="✓  Visita completada"
                                   FontSize="14" FontAttributes="Bold"
                                   TextColor="{StaticResource Primary}"
                                   HorizontalOptions="Center" />
                        </Border>

                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
