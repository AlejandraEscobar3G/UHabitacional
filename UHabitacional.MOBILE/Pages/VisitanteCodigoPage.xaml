<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="UHabitacional.MOBILE.Pages.VisitanteCodigoPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource Background}">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- HEADER -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Padding="16,14">
            <Label Grid.Column="1" Text="Visita registrada" FontSize="16" FontAttributes="Bold"
                   TextColor="{StaticResource Ink}"
                   HorizontalOptions="Center" VerticalOptions="Center" />
        </Grid>

        <!-- BODY: centrado en pantalla -->
        <VerticalStackLayout Grid.Row="1"
                             VerticalOptions="Center"
                             HorizontalOptions="Center"
                             Spacing="20"
                             Padding="32,0">

            <!-- Check de éxito -->
            <Border BackgroundColor="{StaticResource Primary50}"
                    WidthRequest="80" HeightRequest="80"
                    StrokeThickness="0" StrokeShape="RoundRectangle 40"
                    HorizontalOptions="Center">
                <Label Text="✓" FontSize="40" FontAttributes="Bold"
                       TextColor="{StaticResource Primary}"
                       HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>

            <Label x:Name="NombreLabel"
                   FontSize="18" FontAttributes="Bold"
                   TextColor="{StaticResource Ink}"
                   HorizontalTextAlignment="Center" />

            <Label Text="Comparte este código con tu visitante para que el vigilante registre su entrada:"
                   FontSize="13" TextColor="{StaticResource Muted}"
                   HorizontalTextAlignment="Center" />

            <!-- Código grande y copiable -->
            <Border BackgroundColor="{StaticResource Primary}"
                    StrokeThickness="0" StrokeShape="RoundRectangle 16"
                    Padding="28,20"
                    HorizontalOptions="Center">
                <Label x:Name="CodigoLabel"
                       FontSize="36" FontAttributes="Bold"
                       TextColor="White"
                       CharacterSpacing="6"
                       HorizontalOptions="Center" />
            </Border>

            <!-- Botón copiar -->
            <Border BackgroundColor="{StaticResource Surface}"
                    Stroke="{StaticResource Primary}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 12"
                    Padding="20,10"
                    HorizontalOptions="Center">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCopiarTapped" />
                </Border.GestureRecognizers>
                <HorizontalStackLayout Spacing="8">
                    <Label Text="📋" FontSize="14" VerticalOptions="Center" />
                    <Label Text="Copiar código" FontSize="13" FontAttributes="Bold"
                           TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>

            <Label x:Name="CopiadoLabel"
                   IsVisible="False"
                   Text="¡Código copiado!"
                   FontSize="12" TextColor="{StaticResource Success}"
                   HorizontalTextAlignment="Center" />

        </VerticalStackLayout>

        <!-- FOOTER -->
        <VerticalStackLayout Grid.Row="2" Padding="16,0,16,24" Spacing="10">
            <Button Text="Ver mis visitantes"
                    Clicked="OnVerVisitantesClicked" />
            <Button Text="Registrar otro visitante"
                    Clicked="OnOtroVisitanteClicked"
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource Primary}"
                    BorderColor="{StaticResource Line}"
                    BorderWidth="1" />
        </VerticalStackLayout>

    </Grid>
</ContentPage>
