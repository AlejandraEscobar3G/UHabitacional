@{
    ViewBag.PageTitle = "Acceso denegado";
    ViewBag.HideSidebar = true;
}
<div style="min-height:100vh;display:flex;align-items:center;justify-content:center;background:var(--bg)">
    <div class="card" style="max-width:480px;text-align:center;padding:48px 36px">
        @await Html.PartialAsync("_Icons", "alert")
        <h2 style="font-size:24px;font-weight:700;margin:14px 0 8px">Acceso denegado</h2>
        <p style="color:var(--muted);margin-bottom:22px">Tu perfil no tiene permisos para acceder a este recurso.</p>
        <a class="btn btn-primary" href="@Url.Action("Index", "Home")">Volver al inicio</a>
    </div>
</div>
