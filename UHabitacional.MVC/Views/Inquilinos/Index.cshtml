@model IEnumerable<InquilinoDto>

<div class="page-header">
    <div>
        <div class="page-title">Administración de inquilinos</div>
        <div class="page-subtitle">Residentes activos y su asignación a departamentos.</div>
    </div>
    <a class="btn btn-primary" href="@Url.Action("Create")">
        @await Html.PartialAsync("_Icons", "plus")<span>Nuevo inquilino</span>
    </a>
</div>

<div class="table-wrap">
    <table>
        <thead>
            <tr>
                <th>ID</th><th>Nombre</th><th>Correo</th><th>Edificio</th><th>Depto.</th><th>Inicio</th><th>Estatus</th><th style="text-align:right">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr><td colspan="8"><div class="empty-state"><strong>Sin inquilinos</strong><span>Aún no se han registrado residentes.</span></div></td></tr>
            }
            @foreach (var i in Model)
            {
                <tr>
                    <td class="cell-id">IN-@i.IdInquilino.ToString("D3")</td>
                    <td class="cell-strong">@i.NombreUsuario</td>
                    <td>@i.EmailUsuario</td>
                    <td>@i.NombreEdificio</td>
                    <td><span class="pill pill-soft">@i.NumeroDepartamento</span></td>
                    <td>@i.FechaInicio.ToString("dd MMM yyyy")</td>
                    <td>@(i.EstaActivo ? Html.Raw("<span class='pill pill-success'>Activo</span>") : Html.Raw("<span class='pill pill-neutral'>Inactivo</span>"))</td>
                    <td class="cell-actions">
                        <a class="btn btn-ghost btn-sm" href="@Url.Action("Edit", new { id = i.IdInquilino })">
                            @await Html.PartialAsync("_Icons", "edit")<span>Editar</span>
                        </a>
                        <form method="post" action="@Url.Action("Delete", new { id = i.IdInquilino })" style="display:inline" data-confirm="¿Eliminar al inquilino @i.NombreUsuario?">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-danger btn-sm">
                                @await Html.PartialAsync("_Icons", "trash")<span>Eliminar</span>
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <div class="table-foot"><span>Mostrando @Model.Count() registro(s)</span></div>
</div>
