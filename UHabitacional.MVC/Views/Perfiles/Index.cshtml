@model IEnumerable<TipoUsuarioDto>

<div class="page-header">
    <div>
        <div class="page-title">Perfiles de usuario</div>
        <div class="page-subtitle">Roles que determinan los permisos dentro de la plataforma.</div>
    </div>
    <a class="btn btn-primary" href="@Url.Action("Create")">
        @await Html.PartialAsync("_Icons", "plus")<span>Nuevo perfil</span>
    </a>
</div>

<div class="table-wrap">
    <table>
        <thead><tr><th>ID</th><th>Nombre</th><th>Descripción</th><th>Estatus</th><th style="text-align:right">Acciones</th></tr></thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr><td colspan="5"><div class="empty-state"><strong>Sin perfiles</strong><span>Empieza creando los roles del sistema.</span></div></td></tr>
            }
            @foreach (var p in Model)
            {
                <tr>
                    <td class="cell-id">PF-@p.IdTipoUsuario.ToString("D2")</td>
                    <td class="cell-strong">@p.Nombre</td>
                    <td>@(string.IsNullOrEmpty(p.Descripcion) ? "—" : p.Descripcion)</td>
                    <td>@(p.Activo ? Html.Raw("<span class='pill pill-success'>Activo</span>") : Html.Raw("<span class='pill pill-neutral'>Inactivo</span>"))</td>
                    <td class="cell-actions">
                        <a class="btn btn-ghost btn-sm" href="@Url.Action("Edit", new { id = p.IdTipoUsuario })">
                            @await Html.PartialAsync("_Icons", "edit")<span>Editar</span>
                        </a>
                        <form method="post" action="@Url.Action("Delete", new { id = p.IdTipoUsuario })" style="display:inline" data-confirm="¿Eliminar perfil @p.Nombre?">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-danger btn-sm">
                                @await Html.PartialAsync("_Icons", "trash")<span>Eliminar</span>
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <div class="table-foot"><span>Mostrando @Model.Count() registro(s)</span></div>
</div>
