@model IEnumerable<UsuarioDto>

<div class="page-header">
    <div>
        <div class="page-title">Administración de vigilantes</div>
        <div class="page-subtitle">Personal de seguridad asignado a la unidad habitacional.</div>
    </div>
    <a class="btn btn-primary" href="@Url.Action("Create")">
        @await Html.PartialAsync("_Icons", "plus")<span>Nuevo vigilante</span>
    </a>
</div>

<div class="table-wrap">
    <table>
        <thead>
            <tr>
                <th>ID</th><th>Nombre</th><th>Correo</th><th>Identificación</th><th>Teléfono</th><th>Estatus</th><th style="text-align:right">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr><td colspan="7"><div class="empty-state"><strong>Sin vigilantes</strong><span>Aún no se ha dado de alta personal de seguridad.</span></div></td></tr>
            }
            @foreach (var v in Model)
            {
                <tr>
                    <td class="cell-id">VG-@v.IdUsuario.ToString("D3")</td>
                    <td class="cell-strong">@v.Nombre @v.Apellidos</td>
                    <td>@v.Email</td>
                    <td>@v.Identificacion · <span class="cell-id">@v.NumeroIdentificacion</span></td>
                    <td>@(string.IsNullOrEmpty(v.Telefono) ? "—" : v.Telefono)</td>
                    <td>@(v.Activo ? Html.Raw("<span class='pill pill-success'>Activo</span>") : Html.Raw("<span class='pill pill-neutral'>Inactivo</span>"))</td>
                    <td class="cell-actions">
                        <a class="btn btn-ghost btn-sm" href="@Url.Action("Edit", new { id = v.IdUsuario })">
                            @await Html.PartialAsync("_Icons", "edit")<span>Editar</span>
                        </a>
                        <form method="post" action="@Url.Action("Delete", new { id = v.IdUsuario })" style="display:inline" data-confirm="¿Eliminar al vigilante @v.Nombre @v.Apellidos?">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-danger btn-sm">
                                @await Html.PartialAsync("_Icons", "trash")<span>Eliminar</span>
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <div class="table-foot"><span>Mostrando @Model.Count() registro(s)</span></div>
</div>
